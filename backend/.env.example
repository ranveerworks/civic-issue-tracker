# ===================================================================
# Civic Issue Tracker - Backend Environment Configuration
# ===================================================================

# Database Configuration (MySQL 8.0+)
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=mysql+pymysql://root:root@localhost:3306/civic_issue_tracker

# If MySQL is not running on local machine, set to true to enable local SQLite preview fallback
# Set to false in production to enforce MySQL strictly
ALLOW_SQLITE_FALLBACK=true

# Security & JWT
SECRET_KEY=civic-issue-tracker-sharda-university-secret-key-2026-pbl-secure
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Default Admin Seed Credentials
ADMIN_NAME=Civic Administrator
ADMIN_EMAIL=admin@civictracker.gov.in
ADMIN_PASSWORD=Admin@123
ADMIN_MOBILE=+91 9876543210

# Upload Directory for Photographs
UPLOAD_DIR=uploads

# CORS Allowed Origins (Comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
